// Fill these in once (see README, "Set up on your Mac").

// A unique app id. Change "drzaff" if Xcode says it is taken.
APP_BUNDLE_ID = com.drzaff.littlelog

// Your Apple Developer Team ID (10 characters, from developer.apple.com > Membership).
APP_TEAM_ID =

// Copy REVERSED_CLIENT_ID from LittleLog/GoogleService-Info.plist.
REVERSED_CLIENT_ID = com.googleusercontent.apps.77243092185-1eud0q6c8s74p7hnd9c4r1sq5arq3ou4

// Signing. The TestFlight workflow overrides these for App Store builds.
APP_SIGN_STYLE = Automatic
APP_SIGN_IDENTITY = Apple Development
APP_PROFILE =
WIDGET_PROFILE =
APS_ENVIRONMENT = development
